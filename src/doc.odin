package main

/*
This is WIP.

This parses the file generated by the generator.
*/

import "core:log"
import "core:strconv"
import "core:strings"

DOCUMENTATION :: #load("doc.cmd")

parse_int :: strconv.parse_int

Command_Doc :: struct {
	name:    string,
	comment: string,
}

parse :: proc(contents: string, allocator := context.allocator) -> ([dynamic]Command_Doc, int) {
	array: [dynamic]Command_Doc
	array.allocator = allocator
	pos := 0
	largest_name: int

	for {
		if pos >= len(contents) do break
		cmd: Command_Doc
		begin, end: int
		newline := strings.index_rune(contents[pos:], '\n')
		if newline == -1 {
			newline = len(contents) - pos
		}
		newline += pos
		colon := strings.index_rune(contents[pos:newline], ':')
		if colon == -1 {
			cmd.name = contents[pos:newline]
			pos = newline + 1
			if cmd.name == "" do continue
			append(&array, cmd)
			if len(cmd.name) > largest_name do largest_name = len(cmd.name)
			continue
		}
		colon += pos
		second_colon := strings.index_rune(contents[colon + 1:newline], ':')
		assert(second_colon != -1)
		second_colon += colon + 1

		ok: bool
		begin, ok = parse_int(contents[colon + 1:second_colon])
		if !ok {
			log.errorf("failed to parse: %s", contents[colon + 1:second_colon])
			break
		}
		end, ok = parse_int(contents[second_colon + 1:newline])
		if !ok {
			log.errorf("failed to parse: %s", contents[second_colon + 1:newline])
			break
		}
		cmd.name = contents[pos:colon]
		cmd.comment = contents[begin:end]
		append(&array, cmd)
		if len(cmd.name) > largest_name do largest_name = len(cmd.name)
		pos = end + 1
	}
	return array, largest_name
}
