package main

// odin run . -debug -- list -tag:"book,!code" -print:"url,tag" -append:"ORDER BY url DESC"

import odin "base:runtime"
import "core:flags"
import "core:fmt"
import "core:log"
import "core:os"
import "core:strconv"
import "core:strings"
import "core:unicode"
import pipe "shared:odd/pipe"
import term "shared:odd/term"
import sqlite "shared:sqlite"

VERSION :: "2.0.0"

Option :: struct {
	cmd:       string `args:"pos=0" usage:"
    Command to run
    Accepts:
      list,tag,edit,insert,delete,export,
      import,bulk,version,search,help,sql
    "`,
	id:        string `usage:"Database ID"`,
	url:       string `args:"pos=1" usage:"Bookmark URL"`,
	tag:       string `args:"pos=2" usage:"Tag, comma separated"`,
	title:     string `args:"pos=3" usage:"Bookmark title"`,
	note:      string `args:"pos=4" usage:"Bookmark note"`,
	print:     string `usage:"
    Fields to print, comma separated
    Accepts: id,url,tag,title,note
    This affects the print order as well
    "`,
	file:      string `usage:"
    Pass alternative database
    You can also set the BMARK_FILE environment variable
    "`,
	append:    string `usage:"Append extra SQLite query"`,
	separator: rune `usage:"Separator while printing. Defaults to ' '"`,
	dry:       bool `usage:"Dry mode"`,
	force:     bool `usage:"Force operation. See insert command"`,
	verbose:   bool `usage:"Enable verbosity"`,
}

SEPARATOR := ' '

FOREIGN_KEYS :: `PRAGMA foreign_keys = ON;`

INSERT_BOOKMARK :: `
INSERT OR ABORT INTO
  bookmarks (url, title, note, created_at, updated_at)
VALUES (?, ?, ?, strftime('%s','now'), strftime('%s','now'))
`

LIST_QUERY :: `
SELECT
  DISTINCT b.url,
  GROUP_CONCAT(t.tag, ',') AS tags,
  b.title,
  b.note
FROM bookmarks AS b
LEFT JOIN bookmark_tags AS bt
  ON b.id = bt.bookmark_id
LEFT JOIN tags AS t
  ON bt.tag_id = t.id
GROUP BY b.url
`

INSERT_BOOKMARK_FORCE :: `
INSERT INTO
  bookmarks (url, title, note, created_at, updated_at)
VALUES (?, ?, ?, strftime('%s','now'), strftime('%s','now'))
ON CONFLICT(url) DO UPDATE SET
  title = excluded.title,
  note = excluded.note,
  updated_at = strftime('%s','now')
`

CREATE_DATABASE :: `
CREATE TABLE IF NOT EXISTS bookmarks (
  id INTEGER PRIMARY KEY NOT NULL,
  url TEXT NOT NULL UNIQUE,
  title TEXT,
  note TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_url ON bookmarks (url);
CREATE TABLE IF NOT EXISTS tags (
  id INTEGER PRIMARY KEY NOT NULL,
  tag TEXT NOT NULL UNIQUE
);
CREATE INDEX IF NOT EXISTS idx_tag ON tags (tag);
CREATE TABLE IF NOT EXISTS bookmark_tags (
  bookmark_id INTEGER,
  tag_id INTEGER,
  PRIMARY KEY (bookmark_id, tag_id),
  FOREIGN KEY (bookmark_id)
    REFERENCES bookmarks(id) ON DELETE CASCADE,
  FOREIGN KEY (tag_id)
    REFERENCES tags(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_bookmark_id ON bookmark_tags (bookmark_id);
CREATE INDEX IF NOT EXISTS idx_tag_id ON bookmark_tags (tag_id);
`

parse_bookmark_file :: proc(input: string) -> (result: Option, ok: bool) {
	start := strings.index(input, "<A")
	if start == -1 {
		return
	}

	// Skip "<A"
	start += 2
	end := start

	in_quote := false
	for i in start ..< len(input) {
		c := input[i]

		if in_quote {
			if c == '"' {
				in_quote = false
			}
		} else if c == '"' {
			in_quote = true
		} else if c == '>' {
			end = i
			break
		}
	}

	if end == start && (end >= len(input) || input[end] != '>') {
		return
	}

	attrs := input[start:end]
	length := len(attrs)
	i := 0

	skip :: proc(input: string, i: int) -> int {
		i := i
		for i < len(input) && unicode.is_space(rune(input[i])) {
			i += 1
		}
		return i
	}

	for i < len(attrs) {
		// NAME="VALUE"
		name, value: string

		i = skip(attrs, i)
		if i >= length do break

		name_start := i
		for i < length && attrs[i] != '=' {
			i += 1
		}
		name = attrs[name_start:i]

		if attrs[i] != '=' do continue
		// Skip '='
		i += 1

		if attrs[i] != '"' do continue
		// Skip '"'
		i += 1

		value_start := i
		for i < length && attrs[i] != '"' {
			i += 1
		}
		value = attrs[value_start:i]

		if i < length do i += 1

		switch name {
		case "HREF":
			result.url = value
		case "TAGS":
			result.tag = value
		}
	}

	title_start := end + 1
	title_end := strings.index(input[title_start:], "</A>")

	if title_end == -1 {
		return
	}

	result.title = input[title_start:title_start + title_end]

	return result, true
}

/*
Parses a string containing comma separated values (CSV): "tag1,tag2"
*/
get_csv :: proc(s: string) -> (string, int, bool) {
	comma := strings.index_rune(s, ',')
	if comma == -1 {
		return strings.trim(s, " "), comma, true
	} else {
		return strings.trim(s[:comma], " "), comma, false
	}
}

/*
Usage: bmark import FILE

Imports a bookmark.html file, generated by your preferred browser.
*/
@(command)
_import :: proc(db: ^sqlite.SQLite3, opt: ^Option) -> bool {
	path := opt.url
	blocks: []string
	contents, err := os.read_entire_file_from_path(path, allocator = context.allocator)
	defer odin.delete(contents)
	if err != nil {
		log.error(os.error_string(err))
		return false
	}
	blocks, err = strings.split(string(contents), "<DT>")
	if err != nil {
		log.error(os.error_string(err))
		return false
	}

	begin_transaction(db) or_return
	has_err := true
	defer if has_err {
		rollback(db)
	}
	for block in blocks {
		b := strings.trim(block, " ")
		if !strings.starts_with(b, "<A HREF") do continue
		bookmark, ok := parse_bookmark_file(b)
		if !ok do continue
		bookmark.force = opt.force
		insert(db, &bookmark, transactional = false)
	}

	if !opt.dry {
		has_err = false
		commit(db) or_return
	}

	return true
}

/*
Usage: bmark export FILE

Exports the database to FILE.

Example:
  bmark export bookmark.html
*/
@(command)
export :: proc(db: ^sqlite.SQLite3, opt: ^Option) -> bool {
	query :: `
      SELECT
        DISTINCT b.url,
        GROUP_CONCAT(t.tag, ',') AS tags,
        b.title,
        b.created_at,
        b.updated_at
      FROM bookmarks AS b
      LEFT JOIN bookmark_tags AS bt
        ON b.id = bt.bookmark_id
      LEFT JOIN tags AS t
        ON bt.tag_id = t.id
      GROUP BY b.url
    `

	output_file := opt.url
	rows, status := sqlite.execute(db, context.allocator, query)
	defer {
		for row in rows {
			odin.delete(row)
		}
		odin.delete(rows)
	}
	if status != .Done {
		sql_error(db, status)
		return false
	}
	file, err := os.open(output_file, {.Write, .Create, .Trunc}, os.Permissions_Default_File)
	if err != nil {
		log.error(os.error_string(err))
		return false
	}

	HEADING :: `<!DOCTYPE NETSCAPE-Bookmark-file-1>
<META HTTP-EQUIV="Content-Type" CONTENT="text/html; charset=UTF-8">
<TITLE>Bookmarks</TITLE>
<H1>Bookmarks</H1>
<DL><p>`
	os.write_string(file, HEADING)
	os.write_byte(file, '\n')

	for row in rows {
		url := row[0].(cstring)
		tag, ok := row[1].(cstring)
		if !ok do tag = ""
		title := row[2].(cstring)
		add_date := row[3].(i64)
		last_modified := row[4].(i64)
		line := fmt.tprintf(
			"  <DT><A HREF=%q ADD_DATE=\"%d\" LAST_MODIFIED=\"%d\" TAGS=%q>%s</A>\n",
			url,
			add_date,
			last_modified,
			tag,
			title,
		)
		os.write_string(file, line)
	}

	os.write_string(file, "</DL><p>\n")
	return true
}

/*
Displays all tags in the database.

The count subcommand also displays the count of each tag, and is sorted,
from most to least.

Use the -append flag, to overwrite the SQL sorting.
Defaults to: ORDER BY usage_count DESC, t.tag ASC;

Example:
  bmark tag
  bmark tag count
*/
@(command)
tag :: proc(db: ^sqlite.SQLite3, opt: ^Option) -> bool {
	subcmd := opt.url
	query: string
	if subcmd == "count" {
		if opt.append != "" {
			query = fmt.tprintf(
				"SELECT t.tag, COUNT(bt.bookmark_id) AS usage_count FROM tags AS t LEFT JOIN bookmark_tags AS bt ON bt.tag_id = t.id GROUP BY t.id, t.tag %s;",
				opt.append,
			)
		} else {
			query = "SELECT t.tag, COUNT(bt.bookmark_id) AS usage_count FROM tags AS t LEFT JOIN bookmark_tags AS bt ON bt.tag_id = t.id GROUP BY t.id, t.tag ORDER BY usage_count DESC, t.tag ASC;"
		}
	} else {
		if opt.append != "" {
			query = fmt.tprintf("select tag from tags %s;", opt.append)
		} else {
			query = "select tag from tags;"
		}
	}

	return execute_row(db, query)
}

/*
Usage: bmark insert URL TAG TITLE NOTE

Inserts a bookmark into the database.
Supports inserting multiple tags, by separating them by commas.

By default, when a bookmark already exist, the operation is aborted.
You can use the -force flag to overwrite the bookmark instead.

This operation is transactional.

Example:
  bmark -url:https://test.com -tag:mytag,mytag2 -title:Test -note:"My test" insert
  bmark insert https://test.com mytag,mytag2 Test "My test"
*/
@(command)
insert :: proc(db: ^sqlite.SQLite3, opt: ^Option, transactional: bool = true) -> bool {
	if transactional {
		begin_transaction(db) or_return
	}
	has_err := true if transactional else false
	defer if has_err {
		rollback(db)
	}

	query: string
	if opt.force {
		query = INSERT_BOOKMARK_FORCE
	} else {
		query = INSERT_BOOKMARK
	}
	execute(db, query, opt.url, opt.title, opt.note) or_return
	id := get_id(db, "id", "bookmarks", "url", opt.url) or_return

	if opt.tag != "" {
		pos := opt.tag
		for {
			csv, comma, is_end := get_csv(pos)
			execute(db, "INSERT OR IGNORE INTO tags (tag) VALUES (?)", csv) or_return
			tag_id := get_id(db, "id", "tags", "tag", csv) or_return
			execute(
				db,
				"INSERT OR IGNORE INTO bookmark_tags (bookmark_id, tag_id) VALUES(?,?);",
				id,
				tag_id,
			) or_return
			if is_end {break}
			pos = pos[comma + 1:]
		}
	}

	if !opt.dry && transactional {
		has_err = false
		commit(db) or_return
	}

	if opt.verbose {
		fmt.println("Bookmark successfully added: %d", id)
	}
	return true
}

/*
Usage:
  bmark edit old_tag=new_tag
  bmark -id:ID edit URL TAG TITLE NOTE

Edits the bookmark, or a tag.

For renaming tags, use the old_tag=new_tag usage.
For modifying a bookmark tag use comma separated tags. These tags can receive
an '!' prefix, to indicate that they should be removed instead.

This operation is transactional.

Example:
  bmark edit code_typo1=code
  bmark -id:20 edit https://test.com mytag,!myoldtag
*/
@(command)
edit :: proc(db: ^sqlite.SQLite3, opt: ^Option, transactional: bool = true) -> bool {
	if transactional {
		begin_transaction(db) or_return
	}
	has_err := true if transactional else false
	defer if has_err {
		rollback(db)
	}
	out: if opt.tag != "" {
		pos := opt.tag

		equal := strings.index_rune(pos, '=')
		if equal == -1 {
			break out
		}
		if strings.index_rune(pos, ',') != -1 {
			log.error("Unsupported mixture of '=' operation with ','")
			return false
		}
		old := strings.trim(pos[:equal], " ")
		new := strings.trim(pos[equal + 1:], " ")

		execute(db, "UPDATE tags SET tag = ? WHERE tag = ?", old, new) or_return

		if opt.verbose {
			fmt.println("Renamed %s to %s", old, new)
		}
		opt.tag = ""
	}
	if opt.id != "" {
		id, ok := strconv.parse_int(opt.id)
		if !ok {
			log.errorf("Invalid ID: %s", opt.id)
			return false
		}

		write :: strings.write_string
		tprintf :: fmt.tprintf
		query := strings.builder_make(context.allocator)
		defer strings.builder_destroy(&query)

		write(&query, "UPDATE bookmarks SET")
		if opt.url != "" {
			write(&query, tprintf(" url = '%s'", opt.url))
		}
		if opt.title != "" {
			write(&query, tprintf(" title = '%s')", opt.title))
		}
		if opt.note != "" {
			write(&query, tprintf(" note = '%s'", opt.note))
		}
		write(&query, " updated_at = 'strftime('%s','now')'")
		write(&query, tprintf(" WHERE bookmarks.id = %d;", id))

		execute(db, strings.to_string(query)) or_return

		bang :: proc(s: string) -> (string, bool) {
			if s[0] == '!' {
				return s[1:], true
			} else {
				return s, false
			}
		}

		if opt.tag != "" {
			pos := opt.tag
			for {
				csv, comma, is_end := get_csv(pos)
				remove: bool
				csv, remove = bang(csv)
				if remove {
					execute(
						db,
						"DELETE FROM bookmark_tags WHERE bookmark_id = ? AND tag_id IN (SELECT id FROM tags WHERE tag = ?)",
						id,
						csv,
					) or_return
				} else {
					execute(db, "INSERT OR IGNORE INTO tags (tag) VALUES (?)", csv) or_return
					tag_id := sqlite.last_insert_rowid(db)
					execute(
						db,
						"INSERT OR IGNORE INTO bookmark_tags (bookmark_id, tag_id) VALUES(?,?);",
						id,
						tag_id,
					) or_return
					if is_end {break}
					pos = pos[comma + 1:]
				}
			}
		}
	}

	if !opt.dry && transactional {
		has_err = false
		commit(db) or_return
	}

	return true
}

/*
Usage:
  bmark list URL TAG TITLE NOTE
  bmark -url:URL -tag:TAG1,TAG2 -title:TITLE -note:NOTE list

Lists all bookmarks. Each provided argument serves to trim the search down.
By default, each argument is queried with 'AND' SQLite operator. To make it
an 'OR' operator, prefix the argument with '!'.

The list command also accepts the -print flag to construct which fields are
displayed, and which order. And also accepts the -append flag to append
arbitrary SQLite query to the end, like ORDER.

Example:
  bmark -tag:code,!book list
  bmark -id:!20 -tag:code,!book -url:!%github% list
*/
@(command)
list :: proc(db: ^sqlite.SQLite3, opt: ^Option) -> bool {
	write :: strings.write_string
	tprintf :: fmt.tprintf
	group :: "GROUP BY b.id"
	conditions := strings.builder_make(context.allocator)
	defer strings.builder_destroy(&conditions)
	fields: string
	if opt.print != "" {
		parse :: proc(
			print: string,
		) -> (
			id: string,
			url: string,
			tag: string,
			title: string,
			note: string,
		) {
			pos := print
			for {
				csv, comma, is_end := get_csv(pos)
				switch csv {
				case "id":
					if is_end {id = " b.id"} else {id = " b.id,"}
				case "url":
					if is_end {url = " b.url"} else {url = " b.url,"}
				case "tag":
					if is_end {tag = " GROUP_CONCAT(t.tag, ',') AS tags"} else {tag = " GROUP_CONCAT(t.tag, ',') AS tags,"}
				case "title":
					if is_end {title = " b.title"} else {title = " b.title,"}
				case "note":
					if is_end {note = " b.note"} else {note = " b.note,"}
				}
				if is_end {return}
				pos = pos[comma + 1:]
			}
		}

		fields = tprintf("DISTINCT%s%s%s%s%s", parse(opt.print))
	} else {
		fields = "DISTINCT b.id, b.url, GROUP_CONCAT(t.tag, ',') AS tags, b.title, b.note"
	}

	and_or :: proc(sb: ^strings.Builder, s: string) -> string {
		@(static) where_statement: bool = false
		if where_statement == false {
			where_statement = true
			write(sb, "WHERE ")
			if s[0] == '!' do return s[1:]
			else do return s
		}
		if s[0] == '!' {
			write(sb, " OR ")
			return s[1:]
		} else {
			write(sb, " AND ")
			return s
		}
	}

	if opt.id != "" {
		id, ok := strconv.parse_int(and_or(&conditions, opt.id))
		if !ok {
			log.errorf("Invalid ID: %s", opt.id)
			return false
		}
		write(&conditions, tprintf("(b.id = %d)", id))
	}
	if opt.url != "" {
		url := and_or(&conditions, opt.url)
		write(&conditions, tprintf("(b.url LIKE '%s')", url))
	}
	if opt.tag != "" {
		pos := opt.tag
		for {
			pos = and_or(&conditions, pos)
			csv, comma, is_end := get_csv(pos)
			write(&conditions, tprintf("(t.tag LIKE '%s')", csv))
			if is_end {break}
			pos = pos[comma + 1:]
		}
	}
	if opt.title != "" {
		title := and_or(&conditions, opt.title)
		write(&conditions, tprintf("(b.title LIKE '%s')", title))
	}
	if opt.note != "" {
		note := and_or(&conditions, opt.note)
		write(&conditions, tprintf("(b.note LIKE '%s')", note))
	}

	query := tprintf(
		"SELECT %s FROM bookmarks AS b LEFT JOIN bookmark_tags AS bt ON b.id = bt.bookmark_id LEFT JOIN tags AS t ON bt.tag_id = t.id %s %s %s",
		fields,
		strings.to_string(conditions),
		group,
		opt.append,
	)

	when ODIN_DEBUG {
		fmt.println(query)
	}

	return execute_row(db, query)
}

/*
Usage: bmark -id:ID -tag:TAG -url:URL delete

Delete a bookmark by ID or URL, or deletes a tag.

This operation is transactional.

Example:
  bmark -id:20 delete
  bmark -tag:code delete
  bmark delete https://test.com
*/
@(command)
delete :: proc(db: ^sqlite.SQLite3, opt: ^Option, transactional: bool = true) -> bool {
	if transactional {
		begin_transaction(db) or_return
	}
	has_err := true if transactional else false
	defer if has_err {
		rollback(db)
	}
	if opt.id != "" {
		id, ok := strconv.parse_int(opt.id)
		if !ok {
			log.errorf("Invalid ID: %s", opt.id)
			return false
		}
		execute(db, "DELETE FROM bookmarks WHERE id = ?;", id) or_return
		if opt.verbose {
			fmt.println("Removed URL with ID %d", id)
		}
	}
	if opt.tag != "" {
		pos := opt.tag
		for {
			csv, comma, is_end := get_csv(pos)
			execute(db, "DELETE FROM tags WHERE tag = ?;", csv) or_return
			if opt.verbose {
				fmt.println("Removed tag %s", csv)
			}
			if is_end {break}
			pos = pos[comma + 1:]
		}
	}
	if opt.url != "" {
		execute(db, "DELETE FROM bookmarks WHERE url = ?;", opt.url) or_return
		if opt.verbose {
			fmt.println("Removed URL %s", opt.url)
		}
	}

	if !opt.dry && transactional {
		has_err = false
		commit(db) or_return
	}

	return true
}

/*
Usage: bmark version

Prints the program version.
*/
@(command)
version :: proc() {
	fmt.println(VERSION)
}

/*
Usage: bmark search TOPIC CONTEXT

The search command will search the entire documentation for the TOPIC key.
You can include an extra CONTEXT argument, to a context window, similarly
to grep -C.

Example:
  bmark search -append
  bmark search -append 2

Trivia: This is inspired by Fossil SCM 'search' command.
*/
@(command)
search :: proc(opt: ^Option) {
	search := opt.url

	// The context window. 1 means print just the line match, 2 includes
	// one up and another down
	ccontext := parse_int(opt.tag) or_else 1
	cmds, _ := parse(string(DOCUMENTATION))
	defer odin.delete(cmds)

	if search == "" {
		return
	}

	for cmd in cmds {
		comment := cmd.comment

		lines := strings.split_lines(comment)

		once: bool
		for line, i in lines {
			if strings.contains(line, search) {
				if !once {
					fmt.printfln("%s:", cmd.name)
					once = true
				}
				for j := i - ccontext; j < len(lines) && j < i + ccontext; j += 1 {
					term.iprint(lines[j], 4)
					fmt.println()
				}
			}
		}
	}

	return
}

/*
Usage: bmark help COMMAND

Prints the whole documentation for a specified COMMAND.

Example:
  bmark help list

See also: search
*/
@(command)
help :: proc(opt: ^Option) {
	cmd_for_help := opt.url
	cmds, largest_name := parse(string(DOCUMENTATION))
	defer odin.delete(cmds)

	width, _ := term.terminal_size()

	if cmd_for_help == "" {
		for cmd in cmds {
			if cmd.name == "help" {
				fmt.println(cmd.comment)
				break
			}
		}
		fmt.println("\nValues for COMMAND:")

		// Column based writting, with max width
		written: int
		for cmd in cmds {
			padding := largest_name - len(cmd.name) + 2
			if padding + written > width {
				fmt.println()
				written = 0
			}
			written += fmt.printf("%s%s", cmd.name, strings.repeat(" ", padding))
		}
		return
	} else {
		for cmd in cmds {
			if cmd.name == cmd_for_help {
				fmt.println(cmd.comment)
				return
			}
		}
	}
}

/*
Usage: bmark bulk

Opens a temporary file in $EDITOR, containing all bookmarks. Direct changes to it
can perform insertions and deletions.

Invalid lines are ignored.
*/
@(command)
bulk :: proc(db: ^sqlite.SQLite3, opt: ^Option) -> bool {
	query :: LIST_QUERY

	write_row :: proc(rows: [dynamic]sqlite.SQLite_Types, ctx: rawptr) {
		sb := cast(^strings.Builder)ctx
		rows_len := len(rows)
		for row, i in rows {
			strings.write_string(sb, fmt.tprint(row))
			if i + 1 != rows_len {
				strings.write_rune(sb, '│')
			}
		}
		strings.write_rune(sb, '\n')
	}

	sb := strings.builder_make(context.allocator)
	defer strings.builder_destroy(&sb)
	execute_row(db, query, loop_handler = write_row, ctx = &sb) or_return

	write_file :: proc(path: string, sb: strings.Builder) -> bool {
		err := os.write_entire_file_from_string(path, strings.to_string(sb))
		if err != nil {
			log.error(os.error_string(err))
			return false
		}
		return true
	}

	write_file("bmark.tmp", sb) or_return
	defer os.remove("bmark.tmp")

	/*
      Here we are asking the user to edit the bmark.tmp file, where they can
      add new bookmarks, they can modify existing ones and delete.
      After the user writes and the process returns, we run the diff command
      on the original file and the modified one to collect the diff, which
      we inspect and apply our changes.

      The diff parser has been made based on the patterns I found and is still
      WIP
    */
	{
		commands: [dynamic]string
		// Edge case: $EDITOR=emacs -nw -Q
		editor := get_env("EDITOR", "nano")
		for cmd in strings.split_iterator(&editor, " ") {
			append(&commands, cmd)
		}
		append(&commands, "bmark.tmp")
		pipe.run_command(commands[:])
	}

	write_file("bmark.cmp", sb) or_return
	defer os.remove("bmark.cmp")

	p: pipe.Pipe
	pipe.run_command({"diff", "bmark.cmp", "bmark.tmp"}, &p)

	if len(p.stdout) == 0 {
		fmt.println("Nothing to do")
		return true
	}

	split_bulk_line :: proc(
		line: string,
	) -> (
		url: string,
		tag: string,
		title: string,
		note: string,
		ok: bool,
	) {
		delim :: '│'
		l :: 3 // '|' length

		line := line[2:]
		_url := strings.index_rune(line, delim)
		if _url == -1 do return

		_tag := strings.index_rune(line[_url + 1:], delim)
		if _tag == -1 do return
		_tag += _url + 1

		_title := strings.index_rune(line[_tag + 1:], delim)
		if _title == -1 do return
		_title += _tag + 1

		_note := strings.index_rune(line[_title + 1:], '\n')
		if _note == -1 {
			_note = len(line)
		} else {
			_note += _title + 1
		}

		url = line[:_url]
		tag = line[_url + l:_tag]
		title = line[_tag + l:_title]
		note = line[_title + l:_note]

		return url, tag, title, note, true
	}

	begin_transaction(db) or_return
	has_err := true
	defer if has_err {
		rollback(db)
	}

	pos := p.stdout
	lines := strings.split_lines(string(p.stdout))
	line := 0

	deleted_entries: int
	inserted_entries: int
	for line < len(lines) {
		t := Scanner {
			buff = lines[line],
		}
		diff := diffparse(&t) or_break
		line += 1

		begin, end: int

		// Note: diff ranges are inclusive
		switch diff.op {
		case .Delete:
			begin = line
			assert(diff.new[1] == -1)
			// new[1] is the index
			if diff.old[1] == -1 {
				// 2d0
				end = line + 1
			} else {
				// 2,3d10
				end = line + diff.old[1] - diff.old[0] + 1
			}
			deleted_entries += end - begin
		case .Append:
			begin = line
			assert(diff.old[1] == -1)
			// old[1] is the index
			if diff.new[1] == -1 {
				// 2a0
				end = line + 1
			} else {
				// 2a2,3
				end = line + diff.new[1] - diff.new[0] + 1
			}
			inserted_entries += end - begin
		case .Replace:
			l1, l2: int
			if diff.old[1] == -1 {
				// 1c1
				assert(diff.new[1] == -1)
				// 2 -> old file diff + '---'
				begin = line + 2
				end = line + 3
			} else if diff.new[1] == -1 {
				// 1,2c3
				l1 = diff.old[1] - diff.old[0] + 1
				l2 = diff.new[0]
				begin = line + l1 + 1
				end = begin + 1
			} else {
				// 1,3c1,3
				l1 = diff.old[1] - diff.old[0] + 1
				l2 = diff.new[1] - diff.new[0] + 1
				assert(l1 == l2)
				begin = line + l1 + 1
				end = begin + l2
			}
			deleted_entries += (begin - 1) - line
			inserted_entries += end - begin
			for i in line ..< begin - 1 {
				url, _, _, _ := split_bulk_line(lines[i]) or_continue
				option := Option {
					url   = url,
					force = true,
				}
				delete(db, &option, transactional = false)
			}
		}

		for i in begin ..< end {
			url, tag, title, note := split_bulk_line(lines[i]) or_continue
			switch diff.op {
			case .Replace, .Append:
				option := Option {
					url   = url,
					tag   = tag,
					title = title,
					note  = note,
					force = true,
				}
				insert(db, &option, transactional = false)
			case .Delete:
				option := Option {
					url   = url,
					force = true,
				}
				delete(db, &option, transactional = false)
			}
		}

		line += end - 1
	}

	if !opt.dry {
		has_err = false
		commit(db) or_return
	}

	RESET :: "\x1b[0m"
	COLOR_GREEN :: "\x1b[32m"
	COLOR_RED :: "\x1b[31m"

	if opt.verbose {
		if inserted_entries > 0 {
			FMT :: "inserted %d: " + COLOR_GREEN + "+%s" + RESET
			fmt.printfln(FMT, inserted_entries, strings.repeat("+", inserted_entries / 2))
		}
		if deleted_entries > 0 {
			FMT :: "deleted %d: " + COLOR_RED + "+%s" + RESET
			fmt.printfln(FMT, deleted_entries, strings.repeat("+", deleted_entries / 2))
		}
	}

	return true
}

/*
Usage: bmark sql QUERY

Executes arbitrary SQLite code in the database.

Example:
  bmark sql "SELECT * FROM bookmarks WHERE (url LIKE '%github%')"
*/
@(command)
sql :: proc(db: ^sqlite.SQLite3, opt: ^Option) -> bool {
	begin_transaction(db) or_return
	has_err := true
	defer if has_err {
		rollback(db)
	}
	query := opt.url
	if query != "" {
		execute_row(db, query) or_return
		if !opt.dry {
			has_err = false
			commit(db) or_return
		}
		return true
	}
	fmt.println("Usage: bmark sql \"SQL query\"")
	return false
}

main :: proc() {
	log.Level_Headers = {
		0 ..< 10 = "debug: ",
		10 ..< 20 = "info: ",
		20 ..< 30 = "warn: ",
		30 ..< 40 = "error: ",
		40 ..< 50 = "fatal: ",
	}

	context.logger = log.create_console_logger(
		opt = {.Level, .Terminal_Color, .Short_File_Path, .Line},
	)

	opt: Option
	flags.parse_or_exit(&opt, os.args, .Odin)

	// Default values
	if opt.separator != 0 do SEPARATOR = opt.separator

	db: ^sqlite.SQLite3

	BOOKMARK_FILE: string
	if opt.file != "" {
		BOOKMARK_FILE = opt.file
	} else {
		BOOKMARK_FILE = get_env(
			"BMARK_FILE",
			fmt.tprintf("%s/.local/share/bookmarks/bookmark.db", get_env("HOME", "")),
		)
	}

	if !os.exists(BOOKMARK_FILE) {
		err := os.make_directory_all(os.dir(BOOKMARK_FILE))
		if err != nil {
			log.error(os.error_string(err))
			log.destroy_console_logger(context.logger)
			os.exit(1)
		}
		if !execute(db, CREATE_DATABASE) {
			log.destroy_console_logger(context.logger)
			os.exit(1)
		}
		if opt.verbose {
			fmt.println("Database created at %s", BOOKMARK_FILE)
		}
	}

	{
		cstr := strings.clone_to_cstring(BOOKMARK_FILE, context.temp_allocator)
		defer free_all(context.temp_allocator)
		err := sqlite.open(cstr, &db)
		if err != nil {
			log.error(err)
			log.destroy_console_logger(context.logger)
			os.exit(1)
		}
	}

	errcode := dispatch(db, &opt)
	log.destroy_console_logger(context.logger)
	os.exit(cast(int)!errcode)
}

dispatch :: proc(db: ^sqlite.SQLite3, opt: ^Option) -> (ok: bool) {
	ok = true

	defer sqlite.close(db)
	defer if !opt.dry && opt.verbose {
		fmt.println("Total changes:", sqlite.total_changes(db))
	}

	execute(db, FOREIGN_KEYS) or_return

	switch opt.cmd {
	case "list":
		return list(db, opt)
	case "tag":
		return tag(db, opt)
	case "edit":
		return edit(db, opt)
	case "insert":
		return insert(db, opt)
	case "delete":
		return delete(db, opt)
	case "export":
		return export(db, opt)
	case "import":
		return _import(db, opt)
	case "bulk":
		bulk(db, opt)
		return
	case "version":
		version()
		return
	case "search":
		search(opt)
		return
	case "help":
		help(opt)
		return
	case "sql":
		return sql(db, opt)
	case:
		log.errorf("No such command: %q", opt.cmd)
		return
	}

	return
}
